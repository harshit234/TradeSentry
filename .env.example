APP_NAME=Trade Finance Intelligence Layer
APP_VERSION=0.1.0
ENVIRONMENT=local
DEPLOYMENT=local-compose
AWS_REGION=ap-south-1
DATABASE_URL=postgresql+asyncpg://tradesentry:change-me@postgres:5432/tradesentry
REDIS_URL=redis://redis:6379/0
S3_BUCKET=tradesentry-documents-local
S3_ENDPOINT_URL=http://localstack:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
TEXTRACT_ENDPOINT_URL=http://localstack:4566
DYNAMODB_ENDPOINT_URL=http://localstack:4566
CROSS_IBU_TABLE_NAME=TradeFinanceRegistry
S3_KMS_KEY_ID=alias/tradesentry-local
SECRETS_MANAGER_PREFIX=/tradesentry/local
SERVICE_CHECK_MODE=stub
OCR_MODE=stub
MAX_UPLOAD_BYTES=52428800
TEXTRACT_CONFIDENCE_THRESHOLD=0.70
TEXTRACT_TIMEOUT_SECONDS=120
FRAUD_TOOL_TIMEOUT_SECONDS=30
FRAUD_TOOL_RETRY_COUNT=1
INVESTIGATION_TOOL_TIMEOUT_SECONDS=30
INVESTIGATION_TOOL_BUDGET=12
PRICE_TRIAGE_THRESHOLD_USD=700
# Load the RS256 public key from Secrets Manager in deployed environments.
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=tradesentry
JWT_AUDIENCE=tradesentry-dashboard
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=86400
RATE_LIMIT_IP_PER_MINUTE=100
RATE_LIMIT_USER_PER_MINUTE=200
RATE_LIMIT_UPLOAD_PER_MINUTE=10
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000
